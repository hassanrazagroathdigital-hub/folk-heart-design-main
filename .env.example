# Copy this file to `.env` and fill in your Supabase project's values.
# Find them in: Supabase Dashboard → Project Settings → API (or "Data API" / "API Keys").
#
# These are PUBLIC values that end up in the browser bundle. That is expected:
# Row Level Security in supabase/schema.sql is what protects your data.
#
# NEVER put the service_role / secret key in any VITE_ variable.
#
# Vite embeds these at BUILD time: after changing them, rebuild and redeploy.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# "anon" / "publishable" key
VITE_SUPABASE_ANON_KEY=
